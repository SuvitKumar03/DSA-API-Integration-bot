# Files NOT uploaded by `gcloud run deploy --source .`
# Everything git-ignored (keys, .env, private docs, internal terms, logs, chat exports)...
#!include:.gitignore
# ...plus things the image doesn't need
.git
.gitignore
.gcloudignore
docs/
scripts/
chat_export/*
!chat_export/export_gchat.py
!chat_export/clean_chat.py
!chat_export/extraction_prompt.md
cli.py
deploy/
*.md
!knowledge/README.md
!chat_export/extraction_prompt.md

# Copy to .env and fill in. Never commit .env.

# Which model provider answers questions:
#   claude_code       = your own Claude subscription through the Claude Code CLI. Recommended for
#                       running locally: no API key needed. Local only (refuses partner access codes
#                       and non-localhost requests).
#   openai_compatible = any OpenAI-compatible API: Gemini (free), Groq, OpenRouter, Ollama...
#   anthropic         = Claude API key (for the shared/production deployment)
PROVIDER=claude_code

# Claude: API key from https://console.anthropic.com > API keys. To use it: paste the key here and
# set PROVIDER=anthropic (the server refuses to start with PROVIDER=anthropic and no key).
ANTHROPIC_API_KEY=

# Your own Claude via Claude Code (PROVIDER=claude_code). Install it, run `claude` once to sign
# in, then check with: python scripts/check_setup.py
# CLAUDE_CODE_MODEL=sonnet        # or opus (uses your plan's limits faster), haiku
# CLAUDE_CODE_BIN=claude          # full path if `claude` isn't on PATH

# OpenAI-compatible provider (used when PROVIDER=openai_compatible). Example for Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<key from https://aistudio.google.com>
#   LLM_MODEL=<a Gemini model id>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Claude model settings
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Server-side refusal fallback (Claude API only). Set false on Bedrock/Vertex.
ENABLE_FALLBACKS=true

# Branding
BOT_NAME=Thyrocare Integration Assistant
SUPPORT_CONTACT=the Thyrocare integration team

# Partner access codes as "partner:code" pairs. Leave empty for no login (local only!).
# ACCESS_CODES=acme:change-me-123,globex:change-me-456
ACCESS_CODES=

# Rate limits per user (browser + IP)
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_HOUR=60
# Spam protection: STRIKES_TO_BLOCK strikes (gibberish, repeats, off-topic, manipulation)
# within STRIKE_WINDOW_MINUTES block the user for BLOCK_HOURS
# STRIKES_TO_BLOCK=5
# STRIKE_WINDOW_MINUTES=30
# WARN_AFTER_STRIKES=3
# BLOCK_HOURS=2
# BLOCK_BY_IP=true
# MAX_CONCURRENT_ANSWERS=20
# Proxies adding X-Forwarded-For: 0 local, 1 Cloud Run, 2 Cloud Run behind a load balancer
# TRUSTED_PROXY_HOPS=0

# Internal names the bot must never reveal. Required when ACCESS_CODES is set.
# INTERNAL_TERMS_FILE=internal_terms.txt

# Session memory: a short summary of each user's chats, saved in their account
# SUMMARY_IDLE_MINUTES=10      summarise after this much inactivity
# SUMMARY_EVERY_MESSAGES=12    ...or after this many new messages
# SUMMARY_TTL_DAYS=30          memory is ignored after this long without an update

# Where the knowledge files live: local (KNOWLEDGE_DIR) or gcs (Cloud Storage bucket)
# KNOWLEDGE_BACKEND=local
# KNOWLEDGE_BUCKET=my-bot-knowledge
# KNOWLEDGE_PREFIX=knowledge/
# KNOWLEDGE_REFRESH_SECONDS=60   how fast admin updates reach every running instance

# Admins sign in to /admin with Google. Only these emails are admins (comma separated).
# ADMIN_EMAILS=someone@example.com
# OAuth "Web application" client ID (Google Cloud console > APIs & Services > Credentials).
# Add http://localhost:8000 (and your production URL) as Authorized JavaScript origins.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Signs admin session cookies: a long random value, the same on every instance.
# ADMIN_SESSION_SECRET=
# true only when the app is reachable solely through Google IAP (Cloud Run)
# TRUST_IAP=false
# Local-development fallback admin codes as "name:code". Leave empty in production.
# ADMIN_CODES=

# ---------------------------------------------------------------- users
# google = everyone signs in with Google (needs GOOGLE_CLIENT_ID above); each user has their own
# saved chats and memory. none = no sign-in (local testing; one shared local user).
# Default: google when GOOGLE_CLIENT_ID is set, else none.
# USER_LOGIN=google
# Verified Google Workspace accounts on these domains are internal: they also get the internal
# knowledge (repo and Google Chat docs). Everyone else is a partner.
# INTERNAL_DOMAINS=pharmeasy.in,thyrocare.in
# USER_SESSION_DAYS=14
# Teams created the first time (slug:Name). After that, super admins (ADMIN_EMAILS) manage teams
# and add each team's admins on the admin page (Teams).
# DEFAULT_TEAMS=demand:Demand,reporting:Reporting,payments:Payments
# With USER_LOGIN=none: treat the local user (this machine only) as internal, to test repo answers
# LOCAL_USER_INTERNAL=false
# MAX_CONVERSATIONS=200        saved chats kept per user (oldest dropped)

# Where users' chats, memory and the source list are saved: local (DATA_DIR) or gcs (bucket).
# Defaults follow KNOWLEDGE_BACKEND / KNOWLEDGE_BUCKET.
# DATA_BACKEND=local
# DATA_DIR=data
# DATA_BUCKET=my-bot-knowledge
# DATA_PREFIX=data/

# ---------------------------------------------------------------- knowledge sources (admin > Sources)
# Read-only GitHub token: fine-grained, Repository access = the org's repos, Permissions =
# Contents: read-only (+ Metadata). If the org uses SSO, authorise the token for it.
# GITHUB_TOKEN=
# How repos are read: token (GitHub API + GITHUB_TOKEN; needed on servers), git (this computer's
# own git login, e.g. saved in the macOS Keychain: reads what you can read, no token or approval),
# auto = token if GITHUB_TOKEN is set, else git.
# GITHUB_AUTH=auto
# Only repos of these orgs can be added (comma separated, empty = any)
# GITHUB_ORGS=pharmeasy
# REPO_MAX_CHARS=900000        source code read per repo for a full build
# REPO_BATCH_CHARS=150000      code per AI call
# DELTA_MAX_CHARS=200000       a bigger weekly diff rebuilds the doc instead
# DOC_AI_TIMEOUT_SECONDS=900
# INTERNAL_CONTEXT_CHARS=60000 internal doc sections added to an internal user's question
# Google Chat sources use the token from `python chat_export/export_gchat.py --list-spaces`
# GCHAT_TOKEN_FILE=chat_export/token.json
# Scheduled refreshes (each source has its own schedule, set on the admin page)
# SCHEDULER_ENABLED=true
# SCHEDULE_TIMEZONE=Asia/Kolkata
# Cloud Run: Cloud Scheduler calls POST /api/cron/tick with header X-Cron-Secret: <this>
# CRON_SECRET=

# ---------------------------------------------------------------- answer cache and insights
# Same first question (same audience, team, knowledge) = saved answer, no AI call
# ANSWER_CACHE_ENABLED=true
# ANSWER_CACHE_DAYS=7
# Every interaction saved as JSON; weekly AI report (default Monday 10:00), then records cleared
# ANALYTICS_ENABLED=true
# ANALYTICS_DEFAULT_TIME=10:00
# ANALYTICS_BATCH_CHARS=150000
# ANALYTICS_KEEP_EXPORTS=0     keep copies of the analysed raw records for this many runs

# ---------------------------------------------------------------- documentation gaps (admin > Gaps)
# GAP_DEFAULT_TIME=15:00      daily run per team (each list's schedule can be changed on the page)
# GAP_MAX_DRAFTS=10
# Emails are sent from the Gmail account connected with: python scripts/connect_gmail.py
# GMAIL_TOKEN_FILE=chat_export/gmail_token.json
# PUBLIC_URL=http://localhost:8000   address used in email links

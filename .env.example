# Copy to .env and fill in. Never commit .env.

# Which model provider answers questions:
#   anthropic         = Claude API (default, recommended for partners)
#   openai_compatible = any OpenAI-compatible API: Gemini, Groq, OpenRouter, Mistral, local Ollama...
#   claude_code       = local Claude Code CLI on your own subscription (personal local testing only)
PROVIDER=anthropic

# Claude: API key from https://console.anthropic.com (used when PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Local Claude Code CLI on your own subscription (PROVIDER=claude_code).
# PERSONAL LOCAL TESTING ONLY: refuses partner ACCESS_CODES and non-localhost requests.
# CLAUDE_CODE_MODEL=sonnet

# OpenAI-compatible provider (used when PROVIDER=openai_compatible). Example for Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<key from https://aistudio.google.com>
#   LLM_MODEL=<a Gemini model id>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Claude model settings
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Server-side refusal fallback (Claude API only). Set false on Bedrock/Vertex.
ENABLE_FALLBACKS=true

# Branding
BOT_NAME=Thyrocare Integration Assistant
SUPPORT_CONTACT=the Thyrocare integration team

# Partner access codes as "partner:code" pairs. Leave empty for no login (local only!).
# ACCESS_CODES=acme:change-me-123,globex:change-me-456
ACCESS_CODES=

# Questions per partner per hour
RATE_LIMIT_PER_HOUR=60

# Internal names the bot must never reveal. Required when ACCESS_CODES is set.
# INTERNAL_TERMS_FILE=internal_terms.txt

# Session memory kept only in the partner's browser
# SUMMARY_IDLE_MINUTES=10      summarise after this much inactivity
# SUMMARY_EVERY_MESSAGES=12    ...or after this many new messages
# SUMMARY_TTL_DAYS=30          browser forgets the summary after this long

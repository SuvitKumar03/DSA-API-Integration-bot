# Copy to .env and fill in. Never commit .env.

# Which model provider answers questions:
#   claude_code       = your own Claude subscription through the Claude Code CLI. Recommended for
#                       running locally: no API key needed. Local only (refuses partner access codes
#                       and non-localhost requests).
#   openai_compatible = any OpenAI-compatible API: Gemini (free), Groq, OpenRouter, Ollama...
#   anthropic         = Claude API key (for the shared/production deployment)
PROVIDER=claude_code

# Claude: API key from https://console.anthropic.com (used when PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Your own Claude via Claude Code (PROVIDER=claude_code). Install it, run `claude` once to sign
# in, then check with: python scripts/check_setup.py
# CLAUDE_CODE_MODEL=sonnet        # or opus (uses your plan's limits faster), haiku
# CLAUDE_CODE_BIN=claude          # full path if `claude` isn't on PATH

# OpenAI-compatible provider (used when PROVIDER=openai_compatible). Example for Gemini:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_API_KEY=<key from https://aistudio.google.com>
#   LLM_MODEL=<a Gemini model id>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Claude model settings
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Server-side refusal fallback (Claude API only). Set false on Bedrock/Vertex.
ENABLE_FALLBACKS=true

# Branding
BOT_NAME=Thyrocare Integration Assistant
SUPPORT_CONTACT=the Thyrocare integration team

# Partner access codes as "partner:code" pairs. Leave empty for no login (local only!).
# ACCESS_CODES=acme:change-me-123,globex:change-me-456
ACCESS_CODES=

# Questions per partner per hour
RATE_LIMIT_PER_HOUR=60

# Internal names the bot must never reveal. Required when ACCESS_CODES is set.
# INTERNAL_TERMS_FILE=internal_terms.txt

# Session memory kept only in the partner's browser
# SUMMARY_IDLE_MINUTES=10      summarise after this much inactivity
# SUMMARY_EVERY_MESSAGES=12    ...or after this many new messages
# SUMMARY_TTL_DAYS=30          browser forgets the summary after this long

# Where the knowledge files live: local (KNOWLEDGE_DIR) or gcs (Cloud Storage bucket)
# KNOWLEDGE_BACKEND=local
# KNOWLEDGE_BUCKET=my-bot-knowledge
# KNOWLEDGE_PREFIX=knowledge/
# KNOWLEDGE_REFRESH_SECONDS=60   how fast admin updates reach every running instance

# Admins sign in to /admin with Google. Only these emails are admins (comma separated).
# ADMIN_EMAILS=someone@example.com
# OAuth "Web application" client ID (Google Cloud console > APIs & Services > Credentials).
# Add http://localhost:8000 (and your production URL) as Authorized JavaScript origins.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Signs admin session cookies: a long random value, the same on every instance.
# ADMIN_SESSION_SECRET=
# true only when the app is reachable solely through Google IAP (Cloud Run)
# TRUST_IAP=false
# Local-development fallback admin codes as "name:code". Leave empty in production.
# ADMIN_CODES=
